{
  "name": "mis-gastos",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm --prefix web test && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mis-gastos \"node --test rules-tests/*.test.js\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-mis-gastos",
    "deploy": "firebase deploy --only hosting,firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.33.0"
  }
}
